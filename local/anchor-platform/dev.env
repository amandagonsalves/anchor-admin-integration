# =============================================================================
# Stellar Network Configuration
# =============================================================================
STELLAR_NETWORK_TYPE=rpc
STELLAR_NETWORK_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# Secrets and Authentication
# =============================================================================
SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=password

# JWT secrets for the SEP endpoints the platform itself serves.
SECRET_SEP10_JWT_SECRET=secret_sep10_secret_secret_sep10_secret
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET=secret_sep24_interactive_url_jwt_secret

# Shared secrets between the platform and anchor-rust's own business server.
# These MUST match SECRET_CALLBACK_API_AUTH_SECRET / SECRET_PLATFORM_API_AUTH_SECRET
# / SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET in anchor-rust's own .env.
SECRET_CALLBACK_API_AUTH_SECRET=dev_only_callback_api_secret_change_me
SECRET_PLATFORM_API_AUTH_SECRET=dev_only_platform_api_secret_change_me

# SECRET_SEP10_SIGNING_SEED is set dynamically by ap_start.sh.

# =============================================================================
# Logging Configuration
# =============================================================================
APP_LOGGING_STELLAR_LEVEL=DEBUG
APP_LOGGING_REQUEST_LOGGER_ENABLED=true

# =============================================================================
# Event Processing Configuration
# =============================================================================
EVENTS_ENABLED=true
EVENTS_QUEUE_TYPE=kafka
EVENTS_QUEUE_KAFKA_BOOTSTRAP_SERVER=kafka:29092
EVENT_PROCESSOR_CALLBACK_API_REQUEST_ENABLED=true

# =============================================================================
# API Endpoints — anchor-rust runs on the host via `cargo run`, not in this
# compose file, so the platform reaches it over host.docker.internal.
# =============================================================================
CALLBACK_API_BASE_URL=http://host.docker.internal:8091/
PLATFORM_API_BASE_URL=http://platform:8085

# =============================================================================
# Database Configuration (the platform's own — separate from anchor-rust's)
# =============================================================================
DATA_TYPE=postgres
DATA_SERVER=platform-db:5432
DATA_DATABASE=postgres
DATA_SCHEMA=anchor-platform
DATA_FLYWAY_ENABLED=true

# =============================================================================
# Asset Configuration
# =============================================================================
ASSETS_TYPE=file
ASSETS_VALUE=/config/assets.yaml

# =============================================================================
# Stellar Ecosystem Proposals (SEP) Configuration
# =============================================================================
SEP1_ENABLED=true
SEP1_TOML_TYPE=file
SEP1_TOML_VALUE=/config/stellar.localhost.toml

SEP10_ENABLED=true
SEP10_WEB_AUTH_DOMAIN=localhost:8080
SEP10_HOME_DOMAINS=localhost:8080

SEP12_ENABLED=true

SEP24_ENABLED=true
SEP24_INTERACTIVE_URL_BASE_URL=http://localhost:8091/sep24/interactive

SEP31_ENABLED=true

SEP38_ENABLED=true
